    "private": true,
    "dependencies": {
        "axios": "^1.13.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-redux": "^8.1.0",
        "react-router-dom": "^6.14.0",
        "redux-devtools-extension": "^2.13.9",
        "redux-saga": "^1.2.1",
        "web-vitals": "^3.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
